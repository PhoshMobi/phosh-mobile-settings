From 1857ab7dced757484810d30e687859c9c19714c7 Mon Sep 17 00:00:00 2001
Message-ID: <1857ab7dced757484810d30e687859c9c19714c7.1786366384.git.agx@sigxcpu.org>
From: =?UTF-8?q?Guido=20G=C3=BCnther?= <agx@sigxcpu.org>
Date: Fri, 7 Aug 2026 19:11:12 +0200
Subject: [PATCH 1/3] Add variables for plugins
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

This allows us to reference the shared libs individually

Signed-off-by: Guido Günther <agx@sigxcpu.org>
---
 panels/bluetooth/meson.build       | 3 ++-
 panels/online-accounts/meson.build | 3 ++-
 panels/sound/meson.build           | 3 ++-
 panels/wwan/meson.build            | 3 ++-
 4 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/panels/bluetooth/meson.build b/panels/bluetooth/meson.build
index 4b226cc88..c237a80a1 100644
--- a/panels/bluetooth/meson.build
+++ b/panels/bluetooth/meson.build
@@ -39,12 +39,13 @@ sources += gnome.compile_resources(
 
 deps = common_deps + [gnome_bluetooth_dep]
 
-panels_libs += static_library(
+bluetooth_panel_lib = static_library(
   cappletname,
   sources: sources,
   include_directories: top_inc,
   dependencies: deps,
   c_args: cflags
 )
+panels_libs += bluetooth_panel_lib
 
 subdir('icons')
diff --git a/panels/online-accounts/meson.build b/panels/online-accounts/meson.build
index 67300d010..32130ce5e 100644
--- a/panels/online-accounts/meson.build
+++ b/panels/online-accounts/meson.build
@@ -50,12 +50,13 @@ deps = common_deps + [
   dependency('goa-backend-1.0', version: goa_req_version),
 ]
 
-panels_libs += static_library(
+online_accounts_panel_lib = static_library(
   cappletname,
   sources: sources,
   include_directories: [ top_inc, common_inc ],
   dependencies: deps,
   c_args: cflags
 )
+panels_libs += online_accounts_panel_lib
 
 subdir('icons')
diff --git a/panels/sound/meson.build b/panels/sound/meson.build
index 05b6e8ed2..66793666d 100644
--- a/panels/sound/meson.build
+++ b/panels/sound/meson.build
@@ -73,13 +73,14 @@ sources += gnome.compile_resources(
   dependencies: blueprints,
 )
 
-panels_libs += static_library(
+sound_panel_lib = static_library(
   cappletname,
   sources: sources,
   include_directories: [top_inc, common_inc],
   dependencies: deps,
   c_args: cflags,
 )
+panels_libs += sound_panel_lib
 
 sound_data = files(
   'sounds/click.ogg',
diff --git a/panels/wwan/meson.build b/panels/wwan/meson.build
index cbadae59d..c093dd7c8 100644
--- a/panels/wwan/meson.build
+++ b/panels/wwan/meson.build
@@ -55,12 +55,13 @@ sources += gnome.compile_resources(
 
 cflags += '-DGNOMELOCALEDIR="@0@"'.format(control_center_localedir)
 
-panels_libs += static_library(
+wwan_panel_lib = static_library(
            cappletname,
               sources : sources,
   include_directories : [ top_inc, common_inc ],
          dependencies : deps,
                c_args : cflags
 )
+panels_libs += wwan_panel_lib
 
 subdir('icons')
-- 
2.53.0

